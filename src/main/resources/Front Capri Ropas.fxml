                                   <TextField fx:id="fldBuscarEstadoPedido" />
                                   <Label text="Fecha Inicial:" />
                                   <DatePicker fx:id="dtFechaInicialPedido" />
                                   <Label text="Fecha Final:" />
                                   <DatePicker fx:id="dtFechaFinalPedido" />
                                   <Button fx:id="btnRefrescarPedidos" text="Refrescar" />
                                </children>
                             </HBox>
                             <TableView fx:id="tblPedidos" VBox.vgrow="ALWAYS">
                                <columns>
                                   <TableColumn fx:id="colIdPedido" text="ID Pedido" />
                                   <TableColumn fx:id="colFechaPedido" text="Fecha Pedido" />
                                   <TableColumn fx:id="colEstadoPedido" text="Estado" />
                                   <TableColumn fx:id="colMontoPedido" text="Monto Total" />
                                   <TableColumn fx:id="colNombreClientePedido" text="Nombre Cliente" />
                                   <TableColumn fx:id="colAccionesPedido" text="Acciones" />
                                </columns>
                             </TableView>
                          </children>
                       </VBox>
                    </children>
                 </AnchorPane>
              </content>
           </Tab>
           <Tab text="Artículos Web">
              <content>
                 <AnchorPane>
                    <children>
                       <VBox spacing="20" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
                             AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

                          <!-- Header -->
                          <Label text="Subir Artículo a la Web Capri" styleClass="title-label">
                             <font>
                                <Font name="System Bold" size="18.0" />
                             </font>
                          </Label>

                          <!-- Search and Table Section -->
                          <VBox spacing="10" VBox.vgrow="ALWAYS">
                             <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="Buscar:" />
                                <TextField fx:id="fldBuscarArticuloWeb" promptText="Buscar por ID o nombre"
                                           maxWidth="250" />
                                <Button fx:id="btnRefrescarWeb" text="Refrescar" />
                             </HBox>

                             <TableView fx:id="tblProductosWeb" VBox.vgrow="ALWAYS" prefHeight="450">
                                <columns>
                                   <TableColumn fx:id="colIdWeb" text="ID" prefWidth="80" />
                                   <TableColumn fx:id="colPrendaWeb" text="Prenda" prefWidth="250" />
                                   <TableColumn fx:id="colEstadoWeb" text="Estado" prefWidth="150" />
                                   <TableColumn fx:id="colPublicadoWeb" text="Publicado en Web" prefWidth="150" />
                                   <TableColumn fx:id="colAccionesWeb" text="Acciones" prefWidth="200" />
                                </columns>
                             </TableView>
                          </VBox>

                          <!-- Form Section -->
                          <GridPane hgap="20" vgap="15">
                             <padding>
                                <Insets top="10" />
                             </padding>

                             <columnConstraints>
                                <ColumnConstraints minWidth="100" prefWidth="120" />
                                <ColumnConstraints minWidth="200" prefWidth="250" hgrow="SOMETIMES" />
                                <ColumnConstraints minWidth="100" prefWidth="120" />
                                <ColumnConstraints minWidth="200" prefWidth="250" hgrow="SOMETIMES" />
                             </columnConstraints>

                             <!-- Primera columna de campos -->
                             <Label text="Título artículo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                             <TextField fx:id="fldNombreTarjeta" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                             <Label text="Texto Tarjeta:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                             <TextField fx:id="fldTextoTarjeta" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                             <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                             <TextField fx:id="fldPrecioTarjeta" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                             <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                             <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                <ComboBox fx:id="cmbCategoriaWeb" prefWidth="180">
                                   <items>
                                      <FXCollections fx:factory="observableArrayList">
                                         <String fx:value="Tops" />
                                         <String fx:value="Polleras" />
                                         <String fx:value="Pantalones" />
                                         <String fx:value="Minis" />
                                         <String fx:value="Vestidos" />
                                         <String fx:value="Accesorios" />
                                         <String fx:value="Carteras" />
                                         <String fx:value="OnaFitness" />
                                         <String fx:value="Remeras" />
                                         <String fx:value="Bodys" />
                                         <String fx:value="Conjuntos" />
                                         <String fx:value="Shorts" />
                                      </FXCollections>
                                   </items>
                                </ComboBox>
                                <CheckBox fx:id="chkNovedad" text="Novedad" />
                             </HBox>

                             <!-- Segunda columna de campos -->
                             <Label text="Talle:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                             <ComboBox fx:id="cmbTalleWeb" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <items>
                                   <FXCollections fx:factory="observableArrayList">
                                      <String fx:value="" />
                                      <String fx:value="S" />
                                      <String fx:value="M" />
                                      <String fx:value="L" />
                                      <String fx:value="XL" />
                                   </FXCollections>
                                </items>
                             </ComboBox>

                             <Label text="Imagen:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                             <VBox spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                <HBox spacing="10">
                                   <Button fx:id="btnSeleccionarImagen" text="Seleccionar Imagen" onAction="#seleccionarImagen" />
                                   <Label fx:id="lblImagenSeleccionada" />
                                </HBox>
                                <VBox fx:id="dropZoneImagen" alignment="CENTER" prefHeight="80.0" prefWidth="200.0"
                                      style="-fx-border-color: #cccccc; -fx-border-style: dashed; -fx-border-width: 2; -fx-background-color: #f9f9f9;">
                                   <Label text="O arrastra la imagen aquí" style="-fx-text-fill: #888888;" />
                                </VBox>
                             </VBox>

                             <Label text="Detalle:" GridPane.columnIndex="2" GridPane.rowIndex="2"
                                    GridPane.valignment="TOP" GridPane.rowSpan="2" />
                             <TextArea fx:id="fldDetalleTarjeta" prefRowCount="4"
                                       wrapText="true" GridPane.columnIndex="3" GridPane.rowIndex="2"
                                       GridPane.rowSpan="2" />
                          </GridPane>

                          <!-- Action Button -->
                          <Button fx:id="btnGenerarSubirArticulo" text="Generar y Subir Artículo"
                                  onAction="#generarYSubirArticulo" maxWidth="200"
                                  alignment="CENTER" />
                       </VBox>
                    </children>
                 </AnchorPane>
              </content>
           </Tab>
        </tabs>
      </TabPane>
            <Label fx:id="lblLoading" text="⏳ Cargando..." visible="false" managed="false"
                   alignment="CENTER"
                   style="-fx-background-color: rgba(0,0,0,0.55); -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;" />
         </children>
      </StackPane>
   </children>
</VBox>
